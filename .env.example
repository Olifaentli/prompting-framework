# Zugangsdaten für die Anbieter-Schnittstellen.
#
# Diese Datei ist eine Vorlage und enthält bewusst keine Schlüssel. Zum
# Einrichten kopieren und die eigenen Werte einsetzen:
#
#     cp .env.example .env
#
# Die Datei .env ist in .gitignore eingetragen und landet nicht in der
# Versionsverwaltung. Im Quellcode steht nie ein Schlüssel; die Skripte lesen
# ausschliesslich Umgebungsvariablen.
#
# Schlüssel beziehen:
#   Anthropic  console.anthropic.com  -> Settings -> API Keys
#   OpenAI     platform.openai.com    -> API keys
#
# Beide Anbieter rechnen die Schnittstelle getrennt vom Abonnement ab. Ein
# Abonnement enthält kein Guthaben für die Schnittstelle.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
